<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        Fix: Odoo 16 bug where a required selection field with a single
        option appears pre-selected but the onChange never fires, so the
        record value stays False and save fails with "Invalid fields".
        https://github.com/odoo/odoo/issues/184664

        Show the empty placeholder option when the field has no value yet,
        even if the field is required.  The user must explicitly pick the
        option, which triggers onChange and sets the value.
    -->
    <t t-name="web.SelectionField" t-inherit="web.SelectionField" owl="1">
        <xpath expr="//option[1]" position="attributes">
            <attribute name="t-if">!isRequired or !value and value !== 0</attribute>
        </xpath>
    </t>

</templates>
